# --- Rust/Cargo ---
# Ignore the target directory which contains build artifacts
**/target/

# Cargo.lock is intentionally NOT ignored: every crate here is a binary or a
# workspace with binaries, and Cargo recommends committing the lock file so
# builds use the exact dependency versions they were tested with.

# Backup files created by some rust tools
**/*.rs.bk
**/*.rlib
**/*.rmeta
*.so
*.dylib
*.dll

# Cargo and dependency files
.cargo/

# Rust profiling and debugging
*.flamegraph
*.perf
perf.data*
flamegraph.svg

# --- IDEs and Editors ---
# JetBrains (IntelliJ, RustRover, etc.)
.idea/
*.iws
out/

# VS Code
.vscode/

# Vim/Emacs/Nano
[._]*.s[a-v][a-z]
[._]s[a-w][a-z]
*.un~
*~

# --- Operating Systems ---
.DS_Store
Thumbs.db

# --- Environment and Secrets ---
.env
.env.local
.env.*.local

# --- Debugging ---
**/*.pdb
